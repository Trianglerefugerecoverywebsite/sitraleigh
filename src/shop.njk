---
layout: base.njk
title: Shop
description: Sit Raleigh offerings — merch, mentoring, and more. Proceeds support the community.
---

<div class="page-hero">
  <div class="page-hero-inner">
    <p class="page-eyebrow">Shop</p>
    <h1 class="page-headline">Shop</h1>
    <p class="page-sub">Merch, mentoring, and more. Every bit of support helps sustain Sit Raleigh&rsquo;s offerings, which are given freely by dana.</p>
    {% include "page-hero-icon.njk" %}
  </div>
</div>

<section class="section section--parchment">
  <div class="section-inner">
    {% set products = collections.shop | sortByOrder %}
    {% if products.length %}
    <div class="shop-grid">
      {% for product in products %}
      {% set lt = product.data.link_type or "store" %}
      {% if lt == "email" %}
        {% set href = "mailto:" + product.data.buy_url %}
        {% set label = product.data.cta_label or "Email us" %}
        {% set newtab = false %}
      {% elif lt == "page" %}
        {% set href = product.data.buy_url %}
        {% set label = product.data.cta_label or "Learn more" %}
        {% set newtab = false %}
      {% else %}
        {% set href = product.data.buy_url %}
        {% set label = product.data.cta_label or "Shop" %}
        {% set newtab = true %}
      {% endif %}
      <a href="{{ href }}"{% if newtab %} target="_blank" rel="noopener"{% endif %} class="shop-card">
        {% if product.data.image %}
        <div class="shop-card-img" style="background-image:url('{{ product.data.image }}');"></div>
        {% endif %}
        <div class="shop-card-body">
          <h2 class="shop-card-title">{{ product.data.title }}</h2>
          {% if product.data.description %}<p class="shop-card-desc">{{ product.data.description }}</p>{% endif %}
          <div class="shop-card-foot">
            {% if product.data.price %}<span class="shop-card-price">{{ product.data.price }}</span>{% endif %}
            <span class="shop-card-btn">{{ label }} &rarr;</span>
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
    {% else %}
    <p style="text-align:center;color:var(--umber-lt);">Items coming soon.</p>
    {% endif %}
  </div>
</section>
