{% if mailing_list.enabled %}
<section class="mailing-list-section" aria-labelledby="ml-heading">
  <div class="mailing-list-inner">
    <div class="ml-lotus" aria-hidden="true">
      <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M20 34 C20 34 8 26 8 18 C8 12 13 8 20 8 C27 8 32 12 32 18 C32 26 20 34 20 34Z" stroke="rgba(212,184,122,0.4)" stroke-width="0.8" fill="none"/>
        <path d="M20 34 C20 34 10 22 13 15 C15 10 20 8 20 8 C20 8 25 10 27 15 C30 22 20 34 20 34Z" stroke="rgba(212,184,122,0.55)" stroke-width="0.8" fill="none"/>
        <path d="M20 34 C20 34 12 20 16 13 C18 9 20 8 20 8 C20 8 22 9 24 13 C28 20 20 34 20 34Z" stroke="rgba(212,184,122,0.7)" stroke-width="0.8" fill="rgba(122,96,48,0.06)"/>
        <circle cx="20" cy="20" r="2" fill="rgba(212,184,122,0.6)"/>
      </svg>
    </div>

    <h2 class="ml-heading" id="ml-heading">{{ mailing_list.heading }}</h2>
    <p class="ml-sub">{{ mailing_list.subheading }}</p>

    {# ── QR code → Brevo signup form ── #}
    <div class="ml-qr">
      <a
        href="https://e3194ba2.sibforms.com/serve/MUIFAC8clPLTgguqWVlFlU4zXlKVFsbjw-gWLmUoFx8w-_PBupnwpcRl2RELJxVhpNQ1iFWl3BrH2bdNpIkkocc9G13FGc--k5XvgI4ffuYVQoP7chFpfYntSfoHqRy7sMc7sQCXKWoywqu5qNLDxrD_Bv5AFlOEmiXvPXbzuxY1CO2V-0Qn6hKcGDS68E2mCbpl515zHnh8XBYW"
        target="_blank"
        rel="noopener noreferrer"
        class="ml-qr-link"
        aria-label="Open the Sit Raleigh email signup form"
      >
        <img
          src="/images/newsletter-qr.png"
          alt="QR code — scan to join the Sit Raleigh email list"
          width="220"
          height="220"
          loading="lazy"
        />
      </a>
      <p class="ml-qr-caption">Point your phone camera at the code to subscribe</p>
    </div>

    <p class="ml-fine-print">{{ mailing_list.fine_print }}</p>
  </div>
</section>
{% endif %}

<style>
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0,0,0,0);
  white-space: nowrap;
  border: 0;
}
.mailing-list-section {
  background: var(--umber);
  padding: clamp(3rem, 6vw, 5rem) var(--pad);
}
.mailing-list-inner {
  max-width: 540px;
  margin: 0 auto;
  text-align: center;
}
.ml-lotus {
  margin-bottom: 20px;
  display: flex;
  justify-content: center;
}
.ml-heading {
  font-family: var(--font-display);
  font-size: clamp(26px, 4vw, 36px);
  font-weight: 300;
  color: var(--parchment);
  margin-bottom: 12px;
  line-height: 1.2;
}
.ml-sub {
  font-size: 14px;
  line-height: 1.8;
  color: var(--gold-lt);
  margin-bottom: 28px;
  max-width: 400px;
  margin-left: auto;
  margin-right: auto;
}
.ml-form {
  width: 100%;
}
.ml-input-row {
  display: flex;
  gap: 0;
  border: 0.5px solid rgba(212,184,122,0.3);
  border-radius: var(--radius-md);
  overflow: hidden;
  background: rgba(255,255,255,0.05);
}
.ml-input-row input[type="email"] {
  flex: 1;
  padding: 13px 18px;
  font-family: var(--font-body);
  font-size: 14px;
  background: transparent;
  border: none;
  color: var(--parchment);
  outline: none;
  min-width: 0;
}
.ml-input-row input[type="email"]::placeholder { color: rgba(168,144,96,0.6); }
.ml-input-row input[type="email"]:disabled { opacity: 0.5; cursor: not-allowed; }
.ml-btn {
  flex-shrink: 0;
  padding: 13px 22px;
  font-family: var(--font-body);
  font-size: 11px;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  background: var(--gold);
  color: var(--parchment);
  border: none;
  cursor: pointer;
  transition: background 0.2s;
}
.ml-btn:hover:not(:disabled) { background: var(--gold-pale); color: var(--umber); }
.ml-btn:disabled { opacity: 0.5; cursor: not-allowed; }
.ml-fine-print {
  font-size: 11px;
  color: rgba(122,96,48,0.5);
  margin-top: 14px;
  letter-spacing: 0.03em;
}
.ml-coming-soon {
  font-size: 12px;
  color: rgba(168,144,96,0.6);
  margin-top: 10px;
  font-style: italic;
}
.ml-qr {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}
.ml-qr-link {
  display: inline-block;
  padding: 16px;
  background: var(--parchment);
  border-radius: var(--radius-md);
  line-height: 0;
  border: 0.5px solid rgba(212,184,122,0.3);
  transition: transform 0.2s, box-shadow 0.2s;
}
.ml-qr-link:hover {
  transform: translateY(-2px);
  box-shadow: 0 8px 24px rgba(0,0,0,0.25);
}
.ml-qr-link img {
  display: block;
  width: 220px;
  height: 220px;
}
.ml-qr-caption {
  font-size: 13px;
  color: var(--gold-lt);
  letter-spacing: 0.03em;
  margin: 0;
}

@media (max-width: 480px) {
  .ml-input-row { flex-direction: column; }
  .ml-btn { border-radius: 0; }
}
</style>
